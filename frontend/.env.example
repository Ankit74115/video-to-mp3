# ---- Dev-server only (read by vite.config.ts via loadEnv; never shipped to the browser) ----
# Where the Vite dev proxy forwards /api/* requests. The /api prefix is stripped,
# so the browser's /api/login becomes GATEWAY_URL/login.
GATEWAY_URL=http://localhost:8080

# ---- Browser-visible (VITE_* keys are inlined at build time) ----
# Base path the browser calls. Keep /api so both the dev proxy and nginx can route it.
VITE_API_BASE=/api
# How often the Conversions list refreshes while the tab is visible.
VITE_POLL_INTERVAL_MS=3000
# Client-side upload size guard (MiB). The gateway enforces its own limit too.
VITE_MAX_UPLOAD_MB=100
# true = use the in-browser mock API (no backend needed). Default false.
VITE_USE_MOCK_API=false
