# ---- gateway service ----
# Auth service host:port (internal)
AUTH_SVC_ADDRESS=auth:5000
AUTH_TIMEOUT_SECONDS=5

# MongoDB (videos, mp3s and job records all live in MONGO_DB)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=mp3converter

# RabbitMQ. URL-encode the vhost: / becomes %2F
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
VIDEO_QUEUE=video
MP3_QUEUE=mp3

# Max accepted upload size
MAX_UPLOAD_MB=100

# Comma-separated browser origins allowed to call the API directly.
# Leave empty when the frontend proxies /api to the gateway (same origin).
CORS_ORIGINS=

STARTUP_RETRIES=30
STARTUP_RETRY_SECONDS=2
LOG_LEVEL=INFO
