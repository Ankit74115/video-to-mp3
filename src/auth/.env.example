# ---- auth service ----
# MySQL connection
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=auth_user
MYSQL_PASSWORD=change-me
MYSQL_DB=auth

# JWT signing secret. At least 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_HOURS=24

# Demo account seeded on startup if it does not already exist (stored bcrypt-hashed)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me

# Startup wait for MySQL
STARTUP_RETRIES=30
STARTUP_RETRY_SECONDS=2
LOG_LEVEL=INFO
