# ---- notification worker ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
MP3_QUEUE=mp3

# SMTP. For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and use it as SMTP_PASSWORD.
# Leave SMTP_USER and SMTP_PASSWORD empty to disable email (messages are logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_TIMEOUT_SECONDS=20

# Public URL of the frontend, included in the email as a download link (optional)
APP_URL=http://localhost:3000

STARTUP_RETRIES=30
STARTUP_RETRY_SECONDS=2
LOG_LEVEL=INFO
