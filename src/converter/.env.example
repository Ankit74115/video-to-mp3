# ---- converter worker ----
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=mp3converter

# URL-encode the vhost: / becomes %2F
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
VIDEO_QUEUE=video
MP3_QUEUE=mp3

# ffmpeg options
MP3_BITRATE=192k
FFMPEG_TIMEOUT_SECONDS=900
# Remove the uploaded video from storage after a successful conversion
DELETE_SOURCE_VIDEO=false

STARTUP_RETRIES=30
STARTUP_RETRY_SECONDS=2
LOG_LEVEL=INFO
