# Copy to .env and fill in the secrets. Used by docker-compose.yml.
# Per-service variables are documented in src/<service>/.env.example.

# ---- MySQL (auth users) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DB=auth
MYSQL_USER=auth_user
MYSQL_PASSWORD=change-me

# ---- MongoDB (videos, mp3s, jobs) ----
MONGO_DB=mp3converter

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_UI_PORT=15672
VIDEO_QUEUE=video
MP3_QUEUE=mp3

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXP_HOURS=24
# Demo login seeded on first start
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me

# ---- Gateway ----
GATEWAY_PORT=8080
MAX_UPLOAD_MB=100
# Leave empty: the frontend container proxies /api to the gateway (same origin)
CORS_ORIGINS=

# ---- Converter ----
MP3_BITRATE=192k
FFMPEG_TIMEOUT_SECONDS=900
DELETE_SOURCE_VIDEO=false
CONVERTER_REPLICAS=1

# ---- Notification (leave SMTP_USER/SMTP_PASSWORD empty to disable email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:3000

# ---- Frontend ----
FRONTEND_PORT=3000

# ---- Images ----
IMAGE_PREFIX=trackbay
IMAGE_TAG=local
LOG_LEVEL=INFO
